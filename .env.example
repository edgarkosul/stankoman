APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=1800

# Поиск по каталогу. На проде и на деве — Meilisearch одной версии (1.16.0);
# без него Scout откатывается на драйвер collection, а он игнорирует фильтры.
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7703
MEILISEARCH_KEY=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

DADATA_TOKEN=
DADATA_SECRET=
DADATA_BASE=https://suggestions.dadata.ru/suggestions/api/4_1/rs
DADATA_TIMEOUT=4
DADATA_CACHE_TTL=86400
YANDEX_METRIKA_ID=108565390

# Яндекс SmartCaptcha на первом сообщении в чате. По умолчанию капча живёт
# только на проде (CAPTCHA_ENABLED), там и только там есть домен, на который
# выписаны ключи: с включённой проверкой домена токен с localhost не пройдёт.
# Без любой из половин ключа проверка считается выключенной, а не закрытой.
# SMARTCAPTCHA_TEST=true показывает задание ВСЕМ и всегда — только для отладки.
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=
SMARTCAPTCHA_TEST=false

# ИИ-ассистент: шлюз aitunnel, OpenAI-совместимый маршрут — с /v1 на конце.
# AI_EMBEDDING_FAKE=true — векторы из хэша без сети, для тестов и отладки.
AI_GATEWAY_BASE_URL=https://api.aitunnel.ru/v1
AI_GATEWAY_KEY=
AI_EMBEDDING_FAKE=false

# Смысловой поиск по каталогу: зеркало products_semantic в том же Meilisearch,
# что и витринный индекс. Собирается командой ai:catalog-embed (ночью в 03:00),
# до первого прогона бот ищет по одним словам. Значения по умолчанию — в
# config/ai_support.php, здесь только то, что имеет смысл трогать при замерах.
# ⚠️ Доля смысла для обозначений (артикул, модель, бренд) НЕ равна обычной:
# вектор выдуманного слова — шум, и на 0.5 он побеждает точное попадание.
# AI_CATALOG_SEMANTIC_RATIO=0.5
# AI_CATALOG_SEMANTIC_RATIO_MODEL=0.2

# Пуш об эскалации чата в мессенджер MAX. Не задан — канал молча выключен:
# уведомление в админке и письмо менеджеру доходят и без него.
# MAX_BOT_TOKEN=
# MAX_BOT_CHAT_ID=

VITE_APP_NAME="${APP_NAME}"
