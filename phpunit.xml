<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!--
        Тесты на настоящем шлюзе ИИ — только по явной команде (php artisan test
        с опцией group=live, точная команда в CLAUDE.md). Они ходят в сеть
        и стоят копейки, в обычный прогон им незачем. В комментариях XML
        двойной дефис запрещён — поэтому команда здесь не написана целиком.
    -->
    <groups>
        <exclude>
            <group>live</group>
        </exclude>
    </groups>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="RESTIC_BACKUPS_ENABLED" value="false"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!--
            Поиск в тестах — collection-драйвер, как было до появления
            SCOUT_DRIVER в .env. Иначе тесты пишут документы в живой
            Meilisearch дева: id у sqlite свои, и фикстура затирает
            документ настоящего товара с тем же номером.
        -->
        <env name="SCOUT_DRIVER" value="collection"/>
        <!--
            ИИ-ассистент в обычном прогоне — заглушка без сети: вектор из хэша
            одинаков от запуска к запуску, и тест на близости не мигает, а набор
            не ждёт шлюз по пятнадцать секунд. Настоящий шлюз — группа live.
        -->
        <env name="AI_EMBEDDING_FAKE" value="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
